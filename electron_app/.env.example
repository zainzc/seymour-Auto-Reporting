# Reporting Configuration
REPORTING_ENABLED=true
MAX_EXECUTION_LOGS=100

# Schedule Settings
SCHEDULE_TIMEZONE=America/New_York
DB_CONNECT_TIMEOUT_SEC=30
DB_REQUEST_TIMEOUT_MS=120000

# Google OAuth2 Credentials
# Get these from Google Cloud Console: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your-client-id-here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret-here

# Phase 2 Auto-Run (Google Sheet change -> Phase 2 sync)
PHASE2_AUTORUN_ENABLED=true
PHASE2_AUTORUN_POLL_MINUTES=3
PHASE2_AUTORUN_COOLDOWN_MINUTES=5
